# Copy to .env (ignored by Git) and replace every value before starting Docker.
# NEVER commit real secrets, private keys, Stellar S-seeds, or AWS access keys.

# 1. Django Identity & Session Service (encryption/biometric)
DJANGO_SECRET_KEY=
INTERNAL_SERVICE_SECRET=
ADMIN_API_TOKEN=
TOTP_SECRET=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,waf,python-lb,python-a,python-b,identity-a,identity-b
IDENTITY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=false
DJANGO_SESSION_AGE_SECONDS=1800

# 2. Step 1: Google reCAPTCHA Server-Side Validation
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_DEV_TEST_MODE=true

# 3. Step 2: Email OTP Provider (sandbox or smtp)
EMAIL_PROVIDER_MODE=sandbox
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@consensus-lab.local

# 4. Step 3: FacePlugin Open-Source SDK Adapter & Fallback
# Candidate repo: https://github.com/Faceplugin-ltd/Open-Source-Face-Recognition-SDK
FACEPLUGIN_SDK_PATH=
FACEPLUGIN_LICENSE_REVIEWED=false
FACE_MATCH_THRESHOLD=0.72
BIOMETRIC_FALLBACK_CODE=ALT-CONSENSUS-2026

# 5. FastAPI Integration & AWS S3 + IAM Least-Privilege Adapter
AWS_REGION=us-east-1
CONSENSUS_S3_BUCKET=
CONSENSUS_IAM_ROLE_ARN=
CONSENSUS_ENABLE_LIVE_S3=false
CONSENSUS_GITHUB_REPO=MrLuis-WebMaster/consensus
